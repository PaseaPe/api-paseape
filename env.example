# Servidor
SERVER_PORT=7001
SERVER_SERVLET_CONTEXT_PATH=/api-paseape

# Conexión MySQL XAMPP
DATASOURCE_HOST=localhost
DATASOURCE_PORT=3306
DATASOURCE_DATABASE=paseape_db
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=root

# Pool & JPA
MAXIMUM_POOL_SIZE=10
JPA_SHOW_SQL=true

# Flyway
FLYWAY_ENABLED=true

# Google OAuth2 & JWT
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
JWT_SECRET=super_secret_key_paseape_lima_2026_development_token_hash_256bits
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# OCI OBJECT STORAGE (Archivos, fotos y antecedentes)
# ==============================================================================
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxx
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=/ruta/hacia/tu/oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_NAMESPACE=tu_namespace_de_oci
OCI_BUCKET_NAME=paseape-bucket