# ==============================================================================
# ENTORNO Y SERVIDOR HTTP (PaseaPe API - Lima 2026)
# ==============================================================================
SERVER_PORT=7001
SERVER_SERVLET_CONTEXT_PATH=/api-paseape
TZ=America/Lima

# ==============================================================================
# BASE DE DATOS MYSQL (Local XAMPP / Docker / Aiven Cloud)
# Para Local XAMPP : DATASOURCE_HOST=localhost | DATASOURCE_SSL_MODE=PREFERRED
# Para Aiven Cloud  : DATASOURCE_HOST=mysql-xxxx.aivencloud.com | DATASOURCE_SSL_MODE=REQUIRED
# ==============================================================================
DATASOURCE_HOST=localhost
DATASOURCE_PORT=3306
DATASOURCE_DATABASE=paseape_db
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=
DATASOURCE_SSL_MODE=PREFERRED

# Pool de Conexiones HikariCP
MAXIMUM_POOL_SIZE=10

# ==============================================================================
# PERSISTENCIA & MIGRACIONES (JPA / Hibernate / Flyway)
# ==============================================================================
JPA_SHOW_SQL=true
FLYWAY_ENABLED=true

# ==============================================================================
# AUTENTICACIÓN GOOGLE IDENTITY SERVICES (OAuth 2.0 Web Client ID)
# ==============================================================================
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ==============================================================================
# SEGURIDAD JWT (Sesión sin estado - Clave mínima de 256 bits)
# ==============================================================================
JWT_SECRET=super_secret_key_paseape_lima_2026_development_token_hash_256bits_min_32_bytes
JWT_EXPIRATION_MS=86400000